{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug CarteDeBucate.App",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/CarteDeBucate.App/bin/Debug/net10.0/CarteDeBucate.App.dll",
            "args": [],
            "cwd": "${workspaceFolder}/CarteDeBucate.App",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "preLaunchTask": "build-app"
        },
        {
            "name": "Debug CarteDeBucate.Web",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/CarteDeBucate.Web/bin/Debug/net10.0/CarteDeBucate.Web.dll",
            "args": [],
            "cwd": "${workspaceFolder}/CarteDeBucate.Web",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "preLaunchTask": "build-web",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        }
    ]
}