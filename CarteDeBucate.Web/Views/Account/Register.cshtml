@model RegisterViewModel

@{
    ViewData["Title"] = "Creează cont";
}

<div class="mb-4">
    <h1 class="h2">Creează cont</h1>
</div>

<form asp-action="Register" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="mb-3">
        <label asp-for="Username" class="form-label">Username</label>
        <input asp-for="Username" class="form-control" autocomplete="username" />
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label">Parolă</label>
        <input asp-for="Password"
               class="form-control"
               autocomplete="new-password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label">Confirmă parola</label>
        <input asp-for="ConfirmPassword"
               class="form-control"
               autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Creează cont</button>
        <a class="btn btn-outline-secondary"
           asp-action="Login">Autentificare</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
