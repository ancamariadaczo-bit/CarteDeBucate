@model RegisterViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<CarteDeBucate.Web.SharedResource> L
@{ Layout = "_PublicLayout"; ViewData["Title"] = L["Auth_Register"]; ViewData["Description"] = L["Register_Description"]; }
<header class="auth-header"><a class="public-wordmark" asp-controller="Home" asp-action="Index">@L["Site_Title"]</a></header>
<main class="auth-main"><section class="auth-panel" aria-labelledby="register-title">
    <h1 id="register-title">@L["Auth_Register"]</h1><p class="auth-description">@L["Register_Description"]</p>
    <form asp-action="Register" method="post" data-auth-form>
        <div asp-validation-summary="ModelOnly" class="auth-summary" role="alert"></div>
        <div class="auth-field"><label asp-for="Username">@L["Auth_Username"]</label><input asp-for="Username" autocomplete="username" /><span asp-validation-for="Username"></span></div>
        <div class="auth-field"><label asp-for="Password">@L["Auth_Password"]</label><p class="auth-hint">@L["Register_PasswordRequirement"]</p><div class="password-input"><input asp-for="Password" autocomplete="new-password" /><button type="button" data-password-toggle data-show-label="@L["Auth_ShowPassword"]" data-hide-label="@L["Auth_HidePassword"]" aria-label="@L["Auth_ShowPassword"]">@L["Auth_ShowPassword"]</button></div><span asp-validation-for="Password"></span></div>
        <div class="auth-field"><label asp-for="ConfirmPassword">@L["Auth_ConfirmPassword"]</label><div class="password-input"><input asp-for="ConfirmPassword" autocomplete="new-password" /><button type="button" data-password-toggle data-show-label="@L["Auth_ShowPassword"]" data-hide-label="@L["Auth_HidePassword"]" aria-label="@L["Auth_ShowPassword"]">@L["Auth_ShowPassword"]</button></div><span asp-validation-for="ConfirmPassword"></span></div>
        <button class="public-button auth-submit" type="submit" data-submit-label="@L["Auth_Register"]" data-loading-label="@L["Auth_Submitting"]">@L["Auth_Register"]</button>
    </form><p class="auth-switch">@L["Register_Prompt"] <a asp-action="Login">@L["Auth_LoginAction"]</a></p>
</section></main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
