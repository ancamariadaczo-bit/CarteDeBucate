@inject Microsoft.Extensions.Localization.IStringLocalizer<CarteDeBucate.Web.SharedResource> L
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = L["Register_CheckEmail_Title"];
    ViewData["Description"] = L["Register_CheckEmail_Description"];
}
<header class="auth-header"><a class="public-wordmark" asp-controller="Home" asp-action="Index">@L["Site_Title"]</a></header>
<main class="auth-main"><section class="auth-panel" aria-labelledby="check-email-title">
    <h1 id="check-email-title">@L["Register_CheckEmail_Title"]</h1>
    <p class="auth-description">@L["Register_CheckEmail_Description"]</p>
    <p>@L["Register_CheckEmail_Help"]</p>
    <p class="auth-switch"><a asp-action="ResendVerification">@L["ResendVerification_Action"]</a></p>
    <p class="auth-switch"><a asp-action="Login">@L["Auth_LoginAction"]</a></p>
</section></main>
