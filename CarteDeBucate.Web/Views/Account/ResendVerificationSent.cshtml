@inject Microsoft.Extensions.Localization.IStringLocalizer<CarteDeBucate.Web.SharedResource> L
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = L["ResendVerification_Sent_Title"];
    ViewData["Description"] = L["ResendVerification_Sent_Description"];
}
<header class="auth-header"><a class="public-wordmark" asp-controller="Home" asp-action="Index">@L["Site_Title"]</a></header>
<main class="auth-main"><section class="auth-panel" aria-labelledby="resend-verification-sent-title">
    <h1 id="resend-verification-sent-title">@L["ResendVerification_Sent_Title"]</h1>
    <p class="auth-description">@L["ResendVerification_Sent_Description"]</p>
    <p class="auth-switch"><a asp-action="Login">@L["Auth_LoginAction"]</a></p>
</section></main>
