@model Recipe

@{
    ViewData["Title"] = "Șterge rețeta";
    string cancelAction = ViewData["DeleteCancelAction"] as string ?? "Details";
}

<div class="mb-4">
    <h1 class="h2">Șterge rețeta</h1>
    <p class="text-danger mb-0">Această acțiune nu poate fi anulată.</p>
</div>

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<dl class="row mb-4">
    <dt class="col-sm-3">Nume</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        <span class="badge @RecipeStatusPresentation.GetBadgeClass(Model.Status)">
            @RecipeStatusPresentation.GetLabel(Model.Status)
        </span>
    </dd>

    <dt class="col-sm-3">Data salvarii</dt>
    <dd class="col-sm-9">@Model.SavedAt.ToString("dd.MM.yyyy")</dd>
</dl>

<form asp-action="Delete"
      asp-route-id="@Model.Id"
      asp-route-pageNumber="@ViewData["PageNumber"]"
      method="post">
    @if (cancelAction == "Index")
    {
        <input type="hidden" name="returnTo" value="Index" />
    }
    <button type="submit" class="btn btn-danger">Șterge definitiv</button>
    @if (cancelAction == "Index")
    {
        <a class="btn btn-outline-secondary"
           asp-action="Index"
           asp-route-pageNumber="@ViewData["PageNumber"]">Renunță</a>
    }
    else
    {
        <a class="btn btn-outline-secondary"
           asp-action="Details"
           asp-route-id="@Model.Id"
           asp-route-pageNumber="@ViewData["PageNumber"]">Renunță</a>
    }
</form>
