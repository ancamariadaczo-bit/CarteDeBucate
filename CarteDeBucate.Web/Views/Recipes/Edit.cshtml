@model RecipeFormViewModel

@{
    ViewData["Title"] = "Editeaza reteta";
    string cancelAction = ViewData["EditCancelAction"] as string ?? "Details";
}

<div class="mb-4">
    <h1 class="h2">Editeaza reteta</h1>
    <p class="text-muted mb-0">Introdu fiecare ingredient si fiecare pas pe o linie separata.</p>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <input asp-for="Id" type="hidden" />
    <input asp-for="SavedAt" type="hidden" />
    <input asp-for="UserId" type="hidden" />
    @if (cancelAction == "Index")
    {
        <input type="hidden" name="returnTo" value="Index" />
    }

    <partial name="_RecipeForm" model="Model" />

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Salveaza modificarile</button>
        @if (cancelAction == "Index")
        {
            <a class="btn btn-outline-secondary" asp-action="Index">Renunta</a>
        }
        else
        {
            <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Renunta</a>
        }
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Sterge reteta</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
