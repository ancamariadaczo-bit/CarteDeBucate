@model RecipeFormViewModel

@{
    ViewData["Title"] = "Editează rețetă";
    string cancelAction = ViewData["EditCancelAction"] as string ?? "Details";
    string? routeSearchText = ViewData["SearchText"] as string;
    if (string.IsNullOrWhiteSpace(routeSearchText))
    {
        routeSearchText = null;
    }
}

<div class="mb-4">
    <h1 class="h2">Editează rețetă</h1>
    <p class="text-muted mb-0">Introdu fiecare ingredient și fiecare pas pe o linie separată.</p>
</div>

<form asp-action="Edit"
      asp-route-id="@Model.Id"
      asp-route-searchText="@routeSearchText"
      asp-route-pageNumber="@ViewData["PageNumber"]"
      method="post"
      data-track-unsaved-changes="true">
    <input asp-for="Id" type="hidden" />
    <input asp-for="SavedAt" type="hidden" />
    <input asp-for="UserId" type="hidden" />
    @if (cancelAction == "Index")
    {
        <input type="hidden" name="returnTo" value="Index" />
    }

    <partial name="_RecipeForm" model="Model" />

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Salvează modificările</button>
        @if (cancelAction == "Index")
        {
            <a class="btn btn-outline-secondary"
               asp-action="Index"
               asp-route-searchText="@routeSearchText"
               asp-route-pageNumber="@ViewData["PageNumber"]"
               data-confirm-unsaved-changes="true">Renunță</a>
        }
        else
        {
            <a class="btn btn-outline-secondary"
               asp-action="Details"
               asp-route-id="@Model.Id"
               asp-route-searchText="@routeSearchText"
               asp-route-pageNumber="@ViewData["PageNumber"]"
               data-confirm-unsaved-changes="true">Renunță</a>
        }
        <a class="btn btn-outline-danger"
           asp-action="Delete"
           asp-route-id="@Model.Id"
           asp-route-returnTo="@cancelAction"
           asp-route-searchText="@routeSearchText"
           asp-route-pageNumber="@ViewData["PageNumber"]"
           data-confirm-unsaved-changes="true">Șterge rețeta</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
