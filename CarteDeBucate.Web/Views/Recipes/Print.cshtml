@model RecipePrintViewModel

@{
    Layout = null;
    Recipe recipe = Model.Recipe;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@recipe.Name</title>
    <link rel="stylesheet" href="~/css/recipe-print.css" asp-append-version="true" />
</head>
<body>
    <main id="recipe">
        <section class="top">
            <div id="recipeSummary">
                <h1>@recipe.Name</h1>

                @if (!string.IsNullOrWhiteSpace(recipe.SourceUrl))
                {
                    <p class="recipe-source">
                        <strong>Source: </strong>
                        <a href="@recipe.SourceUrl">@recipe.SourceUrl</a>
                    </p>
                }

                <h2>Ingredients</h2>
                <ul>
                    @foreach (string ingredient in recipe.Ingredients)
                    {
                        <li>@ingredient</li>
                    }
                </ul>
            </div>

            <div id="imageSection">
                @if (Model.PrimaryPhotoId.HasValue)
                {
                    <img id="recipeImage"
                         src="@Url.Action("Content", "RecipePhotos", new { id = Model.PrimaryPhotoId.Value })"
                         alt="@recipe.Name"
                         onerror="this.hidden=true;document.getElementById('imageUnavailable').hidden=false" />
                    <p id="imageUnavailable" class="image-error" hidden>Image unavailable</p>
                }
                else
                {
                    <p class="image-error">Image unavailable</p>
                }
            </div>
        </section>

        <section id="stepsSection">
            <h2>Instructions</h2>
            @if (recipe.Steps.Count == 0)
            {
                <p>No steps available.</p>
            }
            else
            {
                <ol>
                    @foreach (string step in recipe.Steps)
                    {
                        <li>@step</li>
                    }
                </ol>
            }
        </section>
    </main>
    <script src="~/js/recipe-print.js" asp-append-version="true"></script>
</body>
</html>
