@model RecipeIndexViewModel

@{
    ViewData["Title"] = "Rețete";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <h1 class="h2 mb-0">Rețete</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Import">Importă din URL</a>
        <a class="btn btn-primary" asp-action="Create">Adaugă rețetă</a>
    </div>
</div>

<form asp-action="Index" method="get" class="row g-2 align-items-center mb-4">
    <div class="col">
        <label for="searchText" class="visually-hidden">Caută rețete</label>
        <input id="searchText"
               name="searchText"
               value="@Model.SearchText"
               class="form-control"
               placeholder="Caută după nume, ingrediente, pași, notițe sau URL" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Caută</button>
    </div>
    @if (Model.IsSearch)
    {
        <div class="col-auto">
            <a class="btn btn-outline-secondary" asp-action="Index">
                Șterge căutarea
            </a>
        </div>
    }
</form>

@if (Model.Recipes.Count == 0)
{
    if (Model.IsSearch)
    {
        <div class="alert alert-info" role="status">
            Nu am găsit rețete pentru „@Model.SearchText”.
            <a asp-action="Index" class="alert-link">Șterge căutarea</a>
        </div>
    }
    else
    {
        <div class="border rounded p-5 text-center bg-light">
            <h2 class="h4">Nu există rețete salvate</h2>
            <p class="text-muted">
                Adaugă prima rețetă manual sau importă una dintr-o pagină web.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a class="btn btn-primary" asp-action="Create">
                    Adaugă prima rețetă
                </a>
                <a class="btn btn-outline-primary" asp-action="Import">
                    Importă din URL
                </a>
            </div>
        </div>
    }
}
else
{
    <p class="text-muted">
        @Model.TotalItems
        @if (Model.IsSearch)
        {
            @(Model.TotalItems == 1 ? "rezultat" : "rezultate")
        }
        else
        {
            @(Model.TotalItems == 1 ? "rețetă" : "rețete")
        }
    </p>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Nume</th>
                    <th scope="col">Status</th>
                    <th scope="col">Data salvarii</th>
                    <th scope="col" class="text-end">Actiuni</th>
                </tr>
            </thead>
            <tbody>
                @foreach (RecipeSummary recipe in Model.Recipes)
                {
                    <tr>
                        <td>
                            <a asp-action="Details"
                               asp-route-id="@recipe.Id"
                               asp-route-pageNumber="@Model.PageNumber">@recipe.Name</a>
                        </td>
                        <td>
                            <span class="badge @RecipeStatusPresentation.GetBadgeClass(recipe.Status)">
                                @RecipeStatusPresentation.GetLabel(recipe.Status)
                            </span>
                        </td>
                        <td>@recipe.SavedAt.ToString("dd.MM.yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary"
                               asp-action="Edit"
                               asp-route-id="@recipe.Id"
                               asp-route-returnTo="Index"
                               asp-route-pageNumber="@Model.PageNumber">Editează</a>
                            <a class="btn btn-sm btn-outline-danger"
                               asp-action="Delete"
                               asp-route-id="@recipe.Id"
                               asp-route-returnTo="Index"
                               asp-route-pageNumber="@Model.PageNumber">Șterge</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Paginare rețete">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    @if (Model.HasPreviousPage)
                    {
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@(Model.PageNumber - 1)">Anterior</a>
                    }
                    else
                    {
                        <span class="page-link">Anterior</span>
                    }
                </li>
                <li class="page-item disabled">
                    <span class="page-link">
                        Pagina @Model.PageNumber din @Model.TotalPages
                    </span>
                </li>
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    @if (Model.HasNextPage)
                    {
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@(Model.PageNumber + 1)">Următor</a>
                    }
                    else
                    {
                        <span class="page-link">Următor</span>
                    }
                </li>
            </ul>
        </nav>
    }
}
