@model RecipeFormViewModel

@{
    ViewData["Title"] = "Adauga reteta";
}

<div class="mb-4">
    <h1 class="h2">Adauga reteta</h1>
    <p class="text-muted mb-0">Introdu fiecare ingredient si fiecare pas pe o linie separata.</p>
</div>

<form asp-action="Create" method="post" data-track-unsaved-changes="true">
    <partial name="_RecipeForm" model="Model" />

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Salveaza</button>
        <a class="btn btn-outline-secondary"
           asp-action="Index"
           data-confirm-unsaved-changes="true">Renunta</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
