@model RecipeFormViewModel

@{
    ViewData["Title"] = "Adaugă rețetă";
}

<div class="mb-4">
    <h1 class="h2">Adaugă rețetă</h1>
    <p class="text-muted mb-0">Introdu fiecare ingredient și fiecare pas pe o linie separată.</p>
</div>

<form asp-action="Create"
      method="post"
      enctype="multipart/form-data"
      data-track-unsaved-changes="true">
    <partial name="_RecipeForm" model="Model" />

    <div class="mb-3">
        <label asp-for="Photo" class="form-label">Fotografie inițială (opțional)</label>
        <input asp-for="Photo"
               class="form-control"
               type="file"
               accept="image/jpeg,image/png,image/webp" />
        <div class="form-text">
            Formate acceptate: JPEG, PNG și WebP. Dimensiune maximă: 10 MiB.
            Dacă formularul conține erori, selectează din nou fișierul.
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Salvează</button>
        <a class="btn btn-outline-secondary"
           asp-action="Index"
           data-confirm-unsaved-changes="true">Renunță</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
