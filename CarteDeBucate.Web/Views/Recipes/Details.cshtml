@model RecipeDetailsViewModel

@{
    Recipe recipe = Model.Recipe;
    ViewData["Title"] = recipe.Name;
    string? routeSearchText = ViewData["SearchText"] as string;
    if (string.IsNullOrWhiteSpace(routeSearchText))
    {
        routeSearchText = null;
    }
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">@recipe.Name</h1>
        <div class="text-muted">
            <span class="badge @RecipeStatusPresentation.GetBadgeClass(recipe.Status)">
                @RecipeStatusPresentation.GetLabel(recipe.Status)
            </span>
            · salvată la @recipe.SavedAt.ToString("dd.MM.yyyy")
        </div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary"
           asp-action="Edit"
           asp-route-id="@recipe.Id"
           asp-route-searchText="@routeSearchText"
           asp-route-pageNumber="@ViewData["PageNumber"]">Editează</a>
        <a class="btn btn-outline-primary"
           asp-action="Print"
           asp-route-id="@recipe.Id"
           target="_blank"
           rel="noopener noreferrer">Printează</a>
        <a class="btn btn-outline-danger"
           asp-action="Delete"
           asp-route-id="@recipe.Id"
           asp-route-searchText="@routeSearchText"
           asp-route-pageNumber="@ViewData["PageNumber"]">Șterge</a>
        <a class="btn btn-outline-primary"
           asp-action="Index"
           asp-route-searchText="@routeSearchText"
           asp-route-pageNumber="@ViewData["PageNumber"]">Înapoi la listă</a>
    </div>
</div>

@if (Model.Photos.Count > 0)
{
    <section class="mb-4" aria-labelledby="recipe-photos-title">
        <h2 id="recipe-photos-title" class="h4">Fotografii</h2>
        <div class="row g-3">
            @foreach (RecipePhotoInfo photo in Model.Photos)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <figure class="card h-100 mb-0">
                        <img class="card-img-top img-fluid"
                             src="@Url.Action("Content", "RecipePhotos", new { id = photo.Id })"
                             alt="@($"{recipe.Name} - {photo.OriginalFileName}")"
                             loading="lazy" />
                        <figcaption class="card-body py-2">
                            <span class="small text-muted">@photo.OriginalFileName</span>
                        </figcaption>
                    </figure>
                </div>
            }
        </div>
    </section>
}

<section class="mb-4">
    <h2 class="h4">Ingrediente</h2>
    <ul>
        @foreach (string ingredient in recipe.Ingredients)
        {
            <li>@ingredient</li>
        }
    </ul>
</section>

<section class="mb-4">
    <h2 class="h4">Pași</h2>
    <ol>
        @foreach (string step in recipe.Steps)
        {
            <li class="mb-2">@step</li>
        }
    </ol>
</section>

@if (!string.IsNullOrWhiteSpace(recipe.Notes))
{
    <section class="mb-4">
        <h2 class="h4">Notițe</h2>
        <p class="text-pre-line">@recipe.Notes</p>
    </section>
}

@if (!string.IsNullOrWhiteSpace(recipe.SourceUrl))
{
    <section>
        <h2 class="h4">Sursa</h2>
        <a href="@recipe.SourceUrl" target="_blank" rel="noopener noreferrer">
            @recipe.SourceUrl
        </a>
    </section>
}
