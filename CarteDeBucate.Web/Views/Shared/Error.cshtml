@model ErrorViewModel

@{
    ViewData["Title"] = "Eroare";
}

<div class="mb-4">
    <h1 class="h2 text-danger">A apărut o eroare</h1>
    <p class="text-muted mb-0">
        Nu am putut procesa cererea. Te rugăm să revii la lista de rețete și să încerci din nou.
    </p>
</div>

<a class="btn btn-primary" asp-controller="Recipes" asp-action="Index">
    Înapoi la rețete
</a>

@if (Model.ShowRequestId)
{
    <p class="text-muted mt-4 mb-0">
        <strong>ID cerere:</strong> <code>@Model.RequestId</code>
    </p>
}
