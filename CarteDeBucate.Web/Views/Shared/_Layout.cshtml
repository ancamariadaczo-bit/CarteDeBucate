<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @if (ViewData["ReferrerPolicy"] is string referrerPolicy)
    {
        <meta name="referrer" content="@referrerPolicy" />
    }
    <title>@ViewData["Title"] - Carte de bucate</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CarteDeBucate.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Recipes" asp-action="Index">Carte de bucate</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Recipes" asp-action="Index">Rețete</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Recipes" asp-action="Create">Adaugă rețetă</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Recipes" asp-action="Import">Importă din URL</a>
                        </li>
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav align-items-sm-center account-navigation">
                            <li class="nav-item dropdown">
                                <button class="nav-link account-menu-trigger"
                                        type="button"
                                        id="account-menu"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                        aria-label="Meniul utilizatorului curent: @User.Identity.Name">
                                    <svg class="account-menu-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                        <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm0 1c-3.07 0-5.5 1.57-5.5 3.5V14h11v-1.5C13.5 10.57 11.07 9 8 9Z" />
                                    </svg>
                                    <span class="account-menu-name text-truncate" title="@User.Identity.Name">@User.Identity.Name</span>
                                    <svg class="account-menu-chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                        <path d="m4.2 6.2 3.8 3.8 3.8-3.8.9.9-4.7 4.7-4.7-4.7.9-.9Z" />
                                    </svg>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end account-menu" aria-labelledby="account-menu">
                                    <li>
                                        <div class="account-menu-identity">
                                            <svg class="account-menu-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                                <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm0 1c-3.07 0-5.5 1.57-5.5 3.5V14h11v-1.5C13.5 10.57 11.07 9 8 9Z" />
                                            </svg>
                                            <div class="account-menu-identity-text">
                                                <span class="account-menu-identity-label">Meniu utilizator</span>
                                                <span class="account-menu-identity-name" title="@User.Identity.Name">@User.Identity.Name</span>
                                            </div>
                                        </div>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Settings" asp-action="Index">Setări</a>
                                    </li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                            <button type="submit" class="dropdown-item">Deconectare</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="alert alert-success" role="status">
                    @successMessage
                </div>
            }
            @if (TempData["ErrorMessage"] is string errorMessage)
            {
                <div class="alert alert-danger" role="alert">
                    @errorMessage
                </div>
            }
            @if (TempData["WarningMessage"] is string warningMessage)
            {
                <div class="alert alert-warning" role="status">
                    @warningMessage
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Carte de bucate
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
