@inject Microsoft.Extensions.Localization.IStringLocalizer<CarteDeBucate.Web.SharedResource> L
@{ ViewData["Title"] = L["EmailChangePending_Title"]; }

<div class="mb-4">
    <h1 class="h2">@L["EmailChangePending_Title"]</h1>
    <p class="text-muted">@L["EmailChangePending_Description"]</p>
</div>

<form asp-action="ResendEmailChange" method="post">
    <button type="submit" class="btn btn-outline-primary">@L["EmailChangePending_Resend"]</button>
</form>
