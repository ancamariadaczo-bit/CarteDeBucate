@model SettingsIndexViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<CarteDeBucate.Web.SharedResource> L
@{ ViewData["Title"] = L["Settings_Title"]; }

<div class="mb-4">
    <h1 class="h2">@L["Settings_Title"]</h1>
    <p class="text-muted mb-0">@L["Settings_Description"]</p>
</div>

<section class="settings-section" aria-labelledby="preferences-heading">
    <h2 id="preferences-heading" class="h4">@L["Settings_Preferences"]</h2>
    <div class="settings-action">
        <div>
            <h3 class="h5">@L["Settings_Language_Title"]</h3>
            <p class="text-muted mb-0">@L["Settings_Language_Description"]</p>
        </div>
        <form asp-action="UpdatePreferredCulture" method="post">
            <div class="mb-3">
                <label asp-for="PreferredCulture.PreferredCulture" class="form-label">@L["Settings_Language_Label"]</label>
                <select asp-for="PreferredCulture.PreferredCulture" class="form-select">
                    <option value="en-US">@L["Culture_English"]</option>
                    <option value="ro-RO">@L["Culture_Romanian"]</option>
                </select>
                <span asp-validation-for="PreferredCulture.PreferredCulture" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">@L["Settings_Save"]</button>
        </form>
    </div>
</section>

<section class="settings-section" aria-labelledby="backup-heading">
    <h2 id="backup-heading" class="h4">Date și backup</h2>
    <p class="text-muted">Păstrează o copie a rețetelor sau adaugă rețete dintr-un fișier JSON.</p>

    <div class="settings-action">
        <div>
            <h3 class="h5">Exportă rețetele</h3>
            <p class="text-muted mb-0">Descarcă rețetele tale într-un fișier JSON.</p>
        </div>
        <form asp-controller="RecipeBackups" asp-action="Export" method="post">
            <button type="submit" class="btn btn-primary">Exportă JSON</button>
        </form>
    </div>

    <div class="settings-action">
        <div>
            <h3 class="h5">Importă rețete</h3>
            <p class="text-muted">Restaurează sau adaugă rețete dintr-un fișier JSON.</p>
        </div>
        <form asp-controller="RecipeBackups" asp-action="Import" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="backupFile" class="form-label">Fișier backup</label>
                <input id="backupFile"
                       name="backupFile"
                       type="file"
                       accept="application/json,.json"
                       class="form-control"
                       required />
            </div>
            <button type="submit" class="btn btn-primary">Importă JSON</button>
        </form>
    </div>
</section>

<section class="settings-section mb-0" aria-labelledby="account-heading">
    <h2 id="account-heading" class="h4">Cont</h2>

    <div class="settings-action">
        <div>
            <h3 class="h5">@L["Settings_EmailChange_Title"]</h3>
            <p class="text-muted mb-0">@L["Settings_EmailChange_Description", Model.CurrentEmail]</p>
        </div>
        <form asp-action="RequestEmailChange" method="post">
            <div class="mb-3">
                <label asp-for="EmailChange.NewEmail" class="form-label">@L["Settings_EmailChange_NewEmail"]</label>
                <input asp-for="EmailChange.NewEmail" class="form-control" autocomplete="email" />
                <span asp-validation-for="EmailChange.NewEmail" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="EmailChange.CurrentPassword" class="form-label">@L["Settings_EmailChange_CurrentPassword"]</label>
                <input asp-for="EmailChange.CurrentPassword" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="EmailChange.CurrentPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">@L["Settings_EmailChange_Submit"]</button>
        </form>
    </div>

    <div class="settings-placeholder">
        <div>
            <h3 class="h5">Schimbă parola</h3>
            <p class="text-muted mb-0">Această opțiune va fi disponibilă în curând.</p>
        </div>
        <span class="settings-coming-soon">În curând</span>
    </div>

    <div class="settings-placeholder">
        <div>
            <h3 class="h5">Șterge contul</h3>
            <p class="text-muted mb-0">Ștergerea permanentă a contului va fi disponibilă în curând.</p>
        </div>
        <span class="settings-coming-soon">În curând</span>
    </div>
</section>
