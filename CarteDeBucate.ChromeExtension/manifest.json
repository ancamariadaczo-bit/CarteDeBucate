{
    "manifest_version": 3,
    "name": "Recipe Clipper – Print & Save Recipes",
    "version": "1.0.0",
    "description": "Extract recipes from web pages and format them for easy printing or saving as PDF.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "identity"
    ],
    "host_permissions": [
        "http://localhost:5080/*",
        "https://localhost:7080/*",
        "https://cartedebucate.onrender.com/"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png"
        }
    },
    "background": {
        "service_worker": "service-worker.js",
        "type": "module"
    }
}