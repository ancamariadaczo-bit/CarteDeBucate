{
    "manifest_version": 3,
    "name": "Recipe Clipper – Print & Save Recipes",
    "version": "1.0.0",
    "minimum_chrome_version": "116",
    "description": "Extract recipes from web pages and format them for easy printing or saving as PDF.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "identity",
        "sidePanel"
    ],
    "host_permissions": [
        "https://localhost:7080/*"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "action": {
        "default_title": "Extract recipe",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png"
        }
    },
    "background": {
        "service_worker": "service-worker.js",
        "type": "module"
    }
}
